# hdyadmin 模块本地开发环境变量示例。
# 使用前复制为 .env.local，并按实际环境修改；不要在版本库中提交真实密钥或证书信息。

# ---------- 模块证书引导 ----------
# LCM 签发的 CA、客户端证书和服务端证书保存目录。
CERTS_DIR=/tmp/hdyadmin-template-certs
# LCM 证书引导服务地址，用于首次签发及后续更新模块 mTLS 证书。
LCM_BOOTSTRAP_ENDPOINT=localhost:9101
# 模块向 LCM 申请证书时使用的共享密钥，必须与 LCM 服务端配置一致。
MODULE_BOOTSTRAP_SECRET=replace-with-development-secret
# LCM 根 CA 的 SHA-256 指纹，用于在首次连接时固定并校验服务端身份。
# 此项为必填安全参数，请替换为实际的十六进制指纹。
LCM_CA_FINGERPRINT=replace-with-lcm-ca-sha256

# ---------- hdyadmin-core 管理面 ----------
# Core 管理服务的 gRPC 地址；模块通过该地址注册元数据并发送心跳。
ADMIN_GRPC_ENDPOINT=localhost:7787
# Core 管理面明文 gRPC 兼容开关；当前模板未直接读取，供配套组件使用。
# 生产环境应关闭并使用 TLS/mTLS。
ADMIN_GRPC_INSECURE=1
# 强制模块注册客户端使用明文 gRPC，适配本地 Core 的非 TLS 端口。
# 生产环境应删除或设为 0，让注册客户端加载 CERTS_DIR 中的 mTLS 证书。
REGISTRATION_INSECURE=1

# ---------- 当前模块的监听与注册地址 ----------
# 向 Core 上报的 gRPC 访问地址；配套 Docker 环境需通过宿主机网关访问本机模块。
GRPC_ADVERTISE_ADDR=host.docker.internal:10400
# 模块 HTTP 服务的监听地址；端口 0 表示由操作系统自动分配空闲端口，避免模板实例冲突。
MODULE_HTTP_ADDR=127.0.0.1:0
# 向 Core 上报的 HTTP 地址；留空时自动使用服务器实际绑定的地址。
# 跨主机或容器部署时，应设置为 Core 能够访问的地址。
HTTP_ADVERTISE_ADDR=
# standalone 后端把实际 HTTP 地址写入此目录，Vite 启动时会自动读取。
MODULE_RUNTIME_DIR=.runtime
# 远程前端的 Module Federation 入口，由宿主前端动态加载。
FRONTEND_ENTRY_URL=http://localhost:3011/remoteEntry.js
# hdyadmin 宿主前端地址；配套 Docker 开发环境默认映射到 8080。
ADMIN_SHELL_URL=http://localhost:8080

# ---------- 可选的本地调试开关 ----------
# 取消注释后跳过 LCM 证书初始化并以无 TLS 模式启动 gRPC，仅用于本地冒烟测试。
# MODULE_TLS_DISABLED=1
# 取消注释后由模块 HTTP 服务直接开放业务路由，不再依赖 Core 动态代理。
# MODULE_STANDALONE=1

# 本地开发时将 Protobuf 全局类型重复注册降级为警告，避免依赖冲突直接导致进程退出。
# 应优先消除重复依赖；不要在生产环境依靠此开关掩盖冲突。
GOLANG_PROTOBUF_REGISTRATION_CONFLICT=warn
