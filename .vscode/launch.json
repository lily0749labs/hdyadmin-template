{
  // VS Code 调试配置：分别支持完全本地的 standalone 模式和连接 Core/LCM 的联调模式。
  "version": "0.2.0",
  "configurations": [
    {
      // 后端独立模式关闭证书与模块注册，业务 HTTP 路由由模块直接提供。
      "name": "Debug template backend (standalone)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/app/admin/cmd/server",
      "cwd": "${workspaceFolder}/app/admin",
      "args": ["-c", "${workspaceFolder}/app/admin/configs"],
      "env": {
        "MODULE_STANDALONE": "1",
        "MODULE_TLS_DISABLED": "1",
        "ADMIN_GRPC_ENDPOINT": "",
        "MODULE_HTTP_ADDR": "127.0.0.1:10401",
        "GOLANG_PROTOBUF_REGISTRATION_CONFLICT": "warn"
      }
    },
    {
      // 后端联调模式从 .env.local 加载 LCM、Core 和证书相关配置。
      "name": "Debug template backend (connected)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/app/admin/cmd/server",
      "cwd": "${workspaceFolder}/app/admin",
      "args": ["-c", "${workspaceFolder}/app/admin/configs"],
      "envFile": "${workspaceFolder}/.env.local"
    },
    {
      // 前端独立模式启动本地调试壳，并将 /api 代理到模块 HTTP 服务。
      "name": "Debug template frontend (standalone)",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend/admin",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/frontend/admin/node_modules/vite/bin/vite.js",
      "args": ["--mode", "standalone", "--port", "3011", "--clearScreen", "false"],
      "console": "internalConsole",
      "preLaunchTask": "Template: install frontend",
      "serverReadyAction": {
        "pattern": "Local:\\s+(http://localhost:3011/)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      // 前端联调模式由宿主 Shell 加载远程模块，调试器打开宿主中的模块路由。
      "name": "Debug template frontend (connected)",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend/admin",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/frontend/admin/node_modules/vite/bin/vite.js",
      "args": ["--mode", "connected", "--port", "3011", "--clearScreen", "false"],
      "console": "internalConsole",
      "preLaunchTask": "Template: install frontend",
      "serverReadyAction": {
        "pattern": "Local:\\s+http://localhost:3011/",
        "uriFormat": "http://localhost:5666/template/example",
        "action": "debugWithChrome"
      }
    }
  ],
  "compounds": [
    {
      // 一次启动无需外部服务的前后端调试环境。
      "name": "Debug template standalone (backend + frontend)",
      "configurations": [
        "Debug template backend (standalone)",
        "Debug template frontend (standalone)"
      ],
      "stopAll": true
    },
    {
      // 一次启动连接真实 Core/LCM/宿主 Shell 的前后端调试环境。
      "name": "Debug template connected (backend + frontend)",
      "configurations": [
        "Debug template backend (connected)",
        "Debug template frontend (connected)"
      ],
      "stopAll": true
    }
  ]
}
